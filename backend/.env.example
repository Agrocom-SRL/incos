# ============================================
# CONFIGURACIÓN DEL ENTORNO - PRODUCCIÓN
# ============================================

# ENTORNO
NODE_ENV=production
PORT=3000

# ============================================
# BASE DE DATOS
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=instituto_incos
DB_USER=root
DB_PASSWORD=Yinux9isql
DB_DIALECT=mysql
DB_LOGGING=false
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ============================================
# JWT (JSON WEB TOKEN)
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_refresh_token_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS
# ============================================
CORS_ORIGIN=https://incos.wiiz.com.bo
CORS_CREDENTIALS=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_SIZE=50m
LOG_MAX_FILES=30

# ============================================
# UPLOADS
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.pdf,.doc,.docx

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sistema@incos.edu.bo
SMTP_PASSWORD=your_email_password
SMTP_FROM=Sistema INCOS <sistema@incos.edu.bo>

# ============================================
# BCRYPT
# ============================================
BCRYPT_SALT_ROUNDS=10

# ============================================
# PAGINATION
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================
# SESSION
# ============================================
SESSION_SECRET=your_session_secret_key
SESSION_TIMEOUT=28800000

# ============================================
# APLICACIÓN
# ============================================
APP_NAME=Sistema INCOS
APP_URL=https://incos.wiiz.com.bo
FRONTEND_URL=https://incos.wiiz.com.bo

# ============================================
# SEGURIDAD
# ============================================
HELMET_ENABLED=true
TRUST_PROXY=true

# ============================================
# REDIS (OPCIONAL - PARA CACHÉ)
# ============================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# BACKUP
# ============================================
BACKUP_DIR=/var/backups/incos
BACKUP_RETENTION_DAYS=30
