# ============================================
# CONFIGURACIÓN DEL ENTORNO - PRODUCCIÓN
# ============================================

# ENTORNO
NODE_ENV=production
PORT=3000

# ============================================
# API DOCUMENTATION (SWAGGER/OPENAPI)
# ============================================
API_TITLE=API Instituto INCOS
API_VERSION=1.0.0
API_DESCRIPTION=Sistema de Gestión Académica - Instituto INCOS Santa Cruz
API_CONTACT_NAME=Soporte Técnico
API_CONTACT_EMAIL=sistema@incos.edu.bo
API_LICENSE_NAME=Privado
API_PRODUCTION_URL=https://sistema.incos-santacruz.edu.bo/api/v1

# ============================================
# BASE DE DATOS
# ============================================
DB_HOST=192.168.100.247
DB_PORT=3306
DB_NAME=instituto_incos
DB_USER=instituto
DB_PASSWORD=Yinux9isql
DB_LOGGING=false
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ============================================
# JWT (JSON WEB TOKEN) — Auth stateful (sesiones)
# ============================================
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=8h
# JWT_REFRESH_SECRET=your_refresh_token_secret_key
# JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS
# ============================================
CORS_ORIGIN=https://sistema.incos-santacruz.edu.bo
CORS_CREDENTIALS=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14

# ============================================
# UPLOADS
# ============================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.webp,.pdf,.doc,.docx

# ============================================
# EMAIL (SMTP) - FUTURO
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=sistema@incos.edu.bo
# SMTP_PASSWORD=your_email_password
# SMTP_FROM=Sistema INCOS <sistema@incos.edu.bo>

# ============================================
# BCRYPT
# ============================================
BCRYPT_SALT_ROUNDS=10

# ============================================
# PAGINATION - FUTURO
# ============================================
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100

# ============================================
# SESSION - FUTURO
# ============================================
# SESSION_SECRET=your_session_secret_key
# SESSION_TIMEOUT=28800000

# ============================================
# APLICACIÓN
# ============================================
APP_NAME=Sistema INCOS
APP_URL=https://sistema.incos-santacruz.edu.bo
FRONTEND_URL=https://sistema.incos-santacruz.edu.bo

# ============================================
# SEGURIDAD
# ============================================
HELMET_ENABLED=true
TRUST_PROXY=false

# ============================================
# REDIS (OPCIONAL - PARA CACHÉ) - FUTURO
# ============================================
# REDIS_ENABLED=false
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ============================================
# BACKUP - FUTURO
# ============================================
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=30