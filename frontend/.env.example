# ============================================================================
# VARIABLES DE ENTORNO - SISTEMA INCOS SANTA CRUZ - PRODUCCIÓN
# ============================================================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Llena los valores según tu entorno (desarrollo/producción)
# 3. NUNCA commitees el archivo .env al repositorio
# 
# ============================================================================

# ============================================================================
# INFORMACIÓN DE LA APLICACIÓN
# ============================================================================
VITE_APP_NAME=INCOS Santa Cruz
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Sistema de Gestión Académica y Administrativa

# ============================================================================
# CONFIGURACIÓN DEL API
# ============================================================================

# URL base del API - PRODUCCIÓN
VITE_API_BASE_URL=https://incos.wiiz.com.bo/api/v1

# Timeout de requests (en milisegundos)
VITE_API_TIMEOUT=10000

# ============================================================================
# AUTENTICACIÓN Y SEGURIDAD
# ============================================================================

# Clave secreta para JWT (solo en desarrollo local, NO usar en producción)
VITE_JWT_SECRET=tu-clave-secreta-muy-segura-cambiar-en-produccion

# Tiempo de expiración del token (en segundos)
# 3600 = 1 hora, 86400 = 1 día, 604800 = 1 semana
VITE_TOKEN_EXPIRATION=86400

# Habilitar refresh token
VITE_ENABLE_REFRESH_TOKEN=true

# ============================================================================
# CONFIGURACIÓN DE LA INSTITUCIÓN
# ============================================================================

# Nombre corto
VITE_INSTITUTO_SHORT_NAME=INCOS

# Nombre completo
VITE_INSTITUTO_FULL_NAME=Instituto Comercial Superior de la Nación

# Ubicación
VITE_INSTITUTO_ADDRESS=Calle Ñuflo de Chávez Nº 62, entre René Moreno y Chuquisaca
VITE_INSTITUTO_CITY=Santa Cruz de la Sierra
VITE_INSTITUTO_COUNTRY=Bolivia

# Contacto
VITE_INSTITUTO_PHONE=72120052
VITE_INSTITUTO_OFFICE_PHONE=3363719
VITE_INSTITUTO_EMAIL=info@incos-santacruz.edu.bo

# ============================================================================
# FEATURES FLAGS (Activar/Desactivar funcionalidades)
# ============================================================================

# Habilitar modo de desarrollo/debug
VITE_ENABLE_DEV_MODE=false

# Habilitar modo oscuro
VITE_ENABLE_DARK_MODE=true

# Habilitar módulo de inscripciones
VITE_ENABLE_ENROLLMENTS=true

# Habilitar módulo de notas
VITE_ENABLE_GRADES=true

# Habilitar módulo de asistencias
VITE_ENABLE_ATTENDANCE=true

# Habilitar reportes
VITE_ENABLE_REPORTS=true

# Habilitar notificaciones
VITE_ENABLE_NOTIFICATIONS=true

# ============================================================================
# SERVICIOS EXTERNOS
# ============================================================================

# Google Analytics (opcional)
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry (monitoreo de errores - opcional)
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Firebase (notificaciones push - opcional)
# VITE_FIREBASE_API_KEY=your-firebase-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id

# ============================================================================
# ALMACENAMIENTO Y ARCHIVOS
# ============================================================================

# URL base para archivos estáticos
VITE_STATIC_URL=https://incos.wiiz.com.bo

# Tamaño máximo de upload (en MB)
VITE_MAX_FILE_SIZE=5

# Tipos de archivo permitidos para upload
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# ============================================================================
# PAGINACIÓN Y LÍMITES
# ============================================================================

# Número de items por página (por defecto)
VITE_DEFAULT_PAGE_SIZE=10

# Máximo de items por página
VITE_MAX_PAGE_SIZE=100

# ============================================================================
# CONFIGURACIÓN DE HORARIOS
# ============================================================================

# Turnos disponibles (separados por coma)
VITE_AVAILABLE_SHIFTS=afternoon,night,saturday

# Horario turno tarde (formato HH:mm)
VITE_AFTERNOON_START=14:00
VITE_AFTERNOON_END=16:30

# Horario turno noche (formato HH:mm)
VITE_NIGHT_START=18:45
VITE_NIGHT_END=22:30

# Horario sábado (formato HH:mm)
VITE_SATURDAY_START=17:00
VITE_SATURDAY_END=21:00

# ============================================================================
# CONFIGURACIÓN ACADÉMICA
# ============================================================================

# Gestión académica actual (formato YYYY-S, ej: 2025-I, 2025-II)
VITE_CURRENT_ACADEMIC_PERIOD=2025-I

# Duración de carreras en semestres
VITE_CAREER_DURATION_SEMESTERS=6

# Porcentaje mínimo de asistencia para aprobar
VITE_MIN_ATTENDANCE_PERCENTAGE=75

# Nota mínima de aprobación (sobre 100)
VITE_MIN_PASSING_GRADE=51

# ============================================================================
# CONFIGURACIÓN DE UI/UX
# ============================================================================

# Tema por defecto (light/dark)
VITE_DEFAULT_THEME=light

# Idioma por defecto (es/en)
VITE_DEFAULT_LANGUAGE=es

# Mostrar logo en login
VITE_SHOW_LOGO_ON_LOGIN=true

# Animaciones habilitadas
VITE_ENABLE_ANIMATIONS=true

# ============================================================================
# MODO DE DESARROLLO
# ============================================================================

# Mostrar logs en consola
VITE_ENABLE_CONSOLE_LOGS=false

# Mostrar información de debug
VITE_ENABLE_DEBUG=false

# Usar mock data (datos de prueba)
VITE_USE_MOCK_DATA=false

# Delay artificial en requests (ms) - útil para testing
VITE_MOCK_API_DELAY=0

# ============================================================================
# INFORMACIÓN DE DESPLIEGUE
# ============================================================================

# Entorno actual
# Valores posibles: development, staging, production
VITE_ENVIRONMENT=production

# Puerto de desarrollo
VITE_DEV_PORT=5173

# URL de producción (para meta tags y SEO)
VITE_PRODUCTION_URL=https://incos.wiiz.com.bo

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================
#
# 🔒 SEGURIDAD:
# - Nunca expongas claves API secretas en variables que empiecen con VITE_
# - Las variables VITE_ son públicas y estarán en el bundle del frontend
# - Para datos sensibles, usa variables de entorno del servidor (backend)
#
# 📝 NAMING:
# - Todas las variables para Vite deben empezar con VITE_
# - Usa SNAKE_CASE para nombres de variables
# - Sé descriptivo en los nombres
#
# 🔄 CAMBIOS:
# - Después de cambiar este archivo, reinicia el servidor de desarrollo
# - Los cambios en .env no se recargan automáticamente
# - En producción, recompila el frontend después de cambiar .env
#
# ============================================================================
