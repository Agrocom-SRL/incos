{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      // Domain Layer
      "@domain/*": [
        "src/domain/*"
      ],
      "@entities/*": [
        "src/domain/entities/*"
      ],
      "@useCases/*": [
        "src/domain/useCases/*"
      ],
      "@repositories/*": [
        "src/domain/repositories/*"
      ],
      // Application Layer
      "@application/*": [
        "./src/application/*"
      ],
      // Infrastructure Layer
      "@infrastructure/*": [
        "./src/infrastructure/*"
      ],
      "@api/*": [
        "./src/infrastructure/api/*"
      ],
      "@repo-impl/*": [
        "./src/infrastructure/repositories/*"
      ],
      "@storage/*": [
        "./src/infrastructure/storage/*"
      ],
      // Presentation Layer
      "@presentation/*": [
        "./src/presentation/*"
      ],
      "@atoms": [
        "./src/presentation/components/atoms/index.js"
      ],
      "@atoms/*": [
        "./src/presentation/components/atoms/*"
      ],
      "@molecules": [
        "./src/presentation/components/molecules/index.js"
      ],
      "@molecules/*": [
        "./src/presentation/components/molecules/*"
      ],
      "@organisms": [
        "./src/presentation/components/organisms/index.js"
      ],
      "@organisms/*": [
        "./src/presentation/components/organisms/*"
      ],
      "@templates": [
        "./src/presentation/templates/index.js"
      ],
      "@templates/*": [
        "./src/presentation/templates/*"
      ],
      "@pages/*": [
        "./src/presentation/pages/*"
      ],
      "@modules/*": [
        "./src/presentation/modules/*"
      ],
      "@estudiantes/*": [
        "./src/presentation/modules/estudiantes/*"
      ],
      // Shared (no existe actualmente, se puede agregar en el futuro)
      "@config/*": [
        "./src/infrastructure/config/*"
      ],
      "@router": [
        "./src/router/index.jsx"
      ],
      "@router/*": [
        "./src/router/*"
      ],
      "@router-config/*": [
        "./src/router/config/*"
      ],
      "@router-utils/*": [
        "./src/router/utils/*"
      ],
      "@theme/*": [
        "./src/infrastructure/config/theme/*"
      ],
      "@layout-components/*": [
        "./src/presentation/templates/mainlayout/components/*"
      ],
      "@assets/*": [
        "./src/presentation/assets/*"
      ],
      "@styles/*": [
        "./src/presentation/styles/*"
      ]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2020",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}