{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            // Domain Layer
            "@domain/*": [
                "src/domain/*"
            ],
            "@useCases/*": [
                "src/domain/useCases/*"
            ],
            "@useCases-estudiantes": [
                "./src/domain/useCases/estudiantes"
            ],
            "@useCases-estudiantes/*": [
                "./src/domain/useCases/estudiantes/*"
            ],
            "@useCases-configuracion": [
                "./src/domain/useCases/configuracion"
            ],
            "@useCases-configuracion/*": [
                "./src/domain/useCases/configuracion/*"
            ],
            "@useCases-academico": [
                "./src/domain/useCases/academico"
            ],
            "@useCases-academico/*": [
                "./src/domain/useCases/academico/*"
            ],
            "@useCases-docentes": [
                "./src/domain/useCases/docentes"
            ],
            "@useCases-docentes/*": [
                "./src/domain/useCases/docentes/*"
            ],
            "@repositories/*": [
                "src/domain/repositories/*"
            ],
            // Application Layer
            "@application/*": [
                "./src/application/*"
            ],
            "@application-utils": [
                "./src/application/utils"
            ],
            "@application-utils/*": [
                "./src/application/utils/*"
            ],
            "@application-navigation": [
                "./src/application/navigation"
            ],
            "@application-navigation/*": [
                "./src/application/navigation/*"
            ],
            // Application Modules
            "@application-estudiantes": [
                "./src/application/modules/estudiantes"
            ],
            "@application-estudiantes/*": [
                "./src/application/modules/estudiantes/*"
            ],
            "@application-estudiantes-old": [
                "./src/application/modules/estudiantes-old"
            ],
            "@application-estudiantes-old/*": [
                "./src/application/modules/estudiantes-old/*"
            ],
            "@application-dashboard": [
                "./src/application/modules/dashboard"
            ],
            "@application-dashboard/*": [
                "./src/application/modules/dashboard/*"
            ],
            "@application-configuracion": [
                "./src/application/modules/configuracion"
            ],
            "@application-configuracion/*": [
                "./src/application/modules/configuracion/*"
            ],
            "@application-inscripciones": [
                "./src/application/modules/inscripciones"
            ],
            "@application-inscripciones/*": [
                "./src/application/modules/inscripciones/*"
            ],
            "@application-matricula": [
                "./src/application/modules/inscripciones"
            ],
            "@application-matricula/*": [
                "./src/application/modules/inscripciones/*"
            ],
            "@application-pagos": [
                "./src/application/modules/pagos"
            ],
            "@application-pagos/*": [
                "./src/application/modules/pagos/*"
            ],
            "@application-academico": [
                "./src/application/modules/academico"
            ],
            "@application-academico/*": [
                "./src/application/modules/academico/*"
            ],
            "@application-auth": [
                "./src/application/modules/auth"
            ],
            "@application-auth/*": [
                "./src/application/modules/auth/*"
            ],
            "@application-docentes": [
                "./src/application/modules/docentes"
            ],
            "@application-docentes/*": [
                "./src/application/modules/docentes/*"
            ],
            "@application-institucional": [
                "./src/application/modules/institucional"
            ],
            "@application-institucional/*": [
                "./src/application/modules/institucional/*"
            ],
            "@container": [
                "./src/application/container/index.js"
            ],
            "@container/*": [
                "./src/application/container/*"
            ],
            // Infrastructure Layer
            "@infrastructure/*": [
                "./src/infrastructure/*"
            ],
            "@api/*": [
                "./src/infrastructure/api/*"
            ],
            "@api-client": [
                "./src/infrastructure/api/client.js"
            ],
            "@implementations/*": [
                "./src/infrastructure/repositories/*"
            ],
            "@storage/*": [
                "./src/infrastructure/storage/*"
            ],
            // Presentation Layer
            "@presentation/*": [
                "./src/presentation/*"
            ],
            "@presentation-utils": [
                "./src/presentation/utils"
            ],
            "@presentation-utils/*": [
                "./src/presentation/utils/*"
            ],
            "@atoms": [
                "./src/presentation/components/atoms"
            ],
            "@atoms/*": [
                "./src/presentation/components/atoms/*"
            ],
            "@molecules": [
                "./src/presentation/components/molecules"
            ],
            "@molecules/*": [
                "./src/presentation/components/molecules/*"
            ],
            // @organisms se usa sin / (tiene index.js)
            "@organisms": [
                "./src/presentation/components/organisms"
            ],
            "@organisms/*": [
                "./src/presentation/components/organisms/*"
            ],
            "@components": [
                "./src/presentation/components"
            ],
            "@components/*": [
                "./src/presentation/components/*"
            ],
            // @templates solo se usa sin / (tiene index.js)
            "@templates": [
                "./src/presentation/templates"
            ],
            "@pages/*": [
                "./src/presentation/pages/*"
            ],
            "@modules": [
                "./src/presentation/modules"
            ],
            "@modules/*": [
                "./src/presentation/modules/*"
            ],
            // Módulos específicos de Presentation
            "@estudiantes/*": [
                "./src/presentation/modules/estudiantes/*"
            ],
            "@estudiantes-old/*": [
                "./src/presentation/modules/estudiantes-old/*"
            ],
            "@dashboard/*": [
                "./src/presentation/modules/dashboard/*"
            ],
            "@configuracion": [
                "./src/presentation/modules/configuracion"
            ],
            "@configuracion/*": [
                "./src/presentation/modules/configuracion/*"
            ],
            "@calificaciones": [
                "./src/presentation/modules/calificaciones"
            ],
            "@calificaciones/*": [
                "./src/presentation/modules/calificaciones/*"
            ],
            "@docentes": [
                "./src/presentation/modules/docentes"
            ],
            "@docentes/*": [
                "./src/presentation/modules/docentes/*"
            ],
            "@institucional": [
                "./src/presentation/modules/institucional"
            ],
            "@institucional/*": [
                "./src/presentation/modules/institucional/*"
            ],
            "@historial": [
                "./src/presentation/modules/historial"
            ],
            "@historial/*": [
                "./src/presentation/modules/historial/*"
            ],
            "@matricula": [
                "./src/presentation/modules/matricula"
            ],
            "@matricula/*": [
                "./src/presentation/modules/matricula/*"
            ],
            "@inscripciones": [
                "./src/presentation/modules/matricula"
            ],
            "@inscripciones/*": [
                "./src/presentation/modules/matricula/*"
            ],
            "@nivelaciones": [
                "./src/presentation/modules/nivelaciones"
            ],
            "@nivelaciones/*": [
                "./src/presentation/modules/nivelaciones/*"
            ],
            "@pagos": [
                "./src/presentation/modules/pagos"
            ],
            "@pagos/*": [
                "./src/presentation/modules/pagos/*"
            ],
            "@reportes": [
                "./src/presentation/modules/reportes"
            ],
            "@reportes/*": [
                "./src/presentation/modules/reportes/*"
            ],
            "@supervision": [
                "./src/presentation/modules/supervision"
            ],
            "@supervision/*": [
                "./src/presentation/modules/supervision/*"
            ],
            "@trazabilidad": [
                "./src/presentation/modules/trazabilidad"
            ],
            "@trazabilidad/*": [
                "./src/presentation/modules/trazabilidad/*"
            ],
            "@usuarios": [
                "./src/presentation/modules/usuarios"
            ],
            "@usuarios/*": [
                "./src/presentation/modules/usuarios/*"
            ],
            // Router Components (Presentation) - Solo se usa con / (ej: @components-router/AppRouter)
            "@components-router/*": [
                "./src/presentation/components/router/*"
            ],
            // Rutas (alias para compatibilidad - ahora apunta a modules/index.js)
            "@routes": [
                "./src/presentation/modules"
            ],
            "@routes/*": [
                "./src/presentation/modules/*"
            ],
            // Navegación (Infrastructure) - Solo se usa con / (ej: @navigation-router/routerConfig)
            "@navigation/*": [
                "./src/infrastructure/navigation/*"
            ],
            "@navigation-services/*": [
                "./src/infrastructure/navigation/services/*"
            ],
            "@navigation-router/*": [
                "./src/infrastructure/navigation/router/*"
            ],
            "@navigation-guards/*": [
                "./src/infrastructure/navigation/guards/*"
            ],
            // Configuración
            "@config/*": [
                "./src/infrastructure/config/*"
            ],
            "@theme/*": [
                "./src/infrastructure/config/theme/*"
            ],
            "@theme": [
                "./src/infrastructure/config/theme"
            ],
            // Assets y estilos
            "@assets/*": [
                "./src/presentation/assets/*"
            ],
            "@styles/*": [
                "./src/presentation/styles/*"
            ]
        },
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "node",
        "target": "ES2020",
        "allowJs": true,
        "checkJs": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "build"
    ]
}